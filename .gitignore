# proj2410 monorepo root .gitignore draft
# Date: 2026-04-13
# Goal: keep source in repo, keep runtime state and experiment artifacts out of git.

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/
*.swp
*.swo
*.tmp

# Python cache / build
__pycache__/
*.py[cod]
*.so
*.o
*.a
*.out
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
build/
dist/
*.egg-info/

# Environments and local secrets
.env
.env.local
.env.*
!.env.example
!.env.template
.envrc
.direnv/
.venv/
venv/
**/.venv/
**/venv/

# Runtime state
/cache/
/hf_home/
/wandb/
/outputs/
/exp/
/logs/
/log/
/tmp/
/megatron_checkpoints/
/runtime/
script/.queue/

# Large artifacts
/model/
/quant_model/
/artifacts/

# Temporary and manual backups
*.bak
*.orig
*.rej
*.original.*

# Logs and reports
*.log
*.logs
*.sqlite3
*.db
*.ncu-rep
*.pid

# Notebooks:
# default to ignoring notebooks; if one needs to be tracked, move it under
# docs/notebooks/ and add an explicit unignore rule below.
*.ipynb
!docs/notebooks/**/*.ipynb

# Known local scratch directories/files observed on 53
/None/
/.pkl_memoize_py3

# Component-local runtime files
EfficientQAT/.venv/

# Notes:
# 1. Do not leave nested .git directories under component dirs in the final monorepo.
# 2. If a notebook should be versioned, move it under a dedicated tracked directory
#    such as docs/notebooks/ and add an explicit unignore rule.
